#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SYNC_CMD="${REPO_ROOT}/bin/monkeys-memory"

if ! command -v bash >/dev/null 2>&1; then
  exit 0
fi

if git rev-parse -q --verify ORIG_HEAD >/dev/null 2>&1; then
  bash "${SYNC_CMD}" sync --no-pull --from-ref ORIG_HEAD --to-ref HEAD || true
else
  bash "${SYNC_CMD}" sync --no-pull || true
fi
