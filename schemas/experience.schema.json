{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.infmonkeys.com/schemas/experience.schema.json",
  "title": "Experience",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "org",
    "repo",
    "title",
    "claim",
    "scope",
    "source",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "org": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["rule", "exception", "procedure", "checklist", "note"],
      "default": "rule"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "task_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "session"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated"],
      "default": "active"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["candidate", "active", "confirmed", "contested", "stale", "deprecated", "superseded"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "superseded_by": {
          "type": ["string", "null"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "commit": {
          "type": ["string", "null"]
        },
        "branch": {
          "type": ["string", "null"]
        },
        "imported_from": {
          "type": ["string", "null"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supports": { "$ref": "#/$defs/idList" },
        "contradicts": { "$ref": "#/$defs/idList" },
        "supersedes": { "$ref": "#/$defs/idList" },
        "superseded_by": { "$ref": "#/$defs/idList" },
        "specializes": { "$ref": "#/$defs/idList" },
        "generalizes": { "$ref": "#/$defs/idList" },
        "related_to": { "$ref": "#/$defs/idList" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "type": "string",
          "enum": ["user", "repo", "team", "org", "global"]
        },
        "sensitivity": {
          "type": "string",
          "enum": ["normal", "internal", "secret-adjacent"]
        },
        "redaction_status": {
          "type": "string",
          "enum": ["not_scanned", "clean", "redacted", "blocked"]
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branches": { "$ref": "#/$defs/idList" },
        "valid_from_commit": {
          "type": ["string", "null"]
        },
        "valid_until_commit": {
          "type": ["string", "null"]
        },
        "tags": { "$ref": "#/$defs/idList" }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
