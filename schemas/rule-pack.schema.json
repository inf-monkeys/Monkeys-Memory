{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.infmonkeys.com/schemas/rule-pack.schema.json",
  "title": "RulePack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "org",
    "repo",
    "generated_at",
    "source_experience_count",
    "rules",
    "exceptions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "org": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_experience_count": {
      "type": "integer",
      "minimum": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "procedures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "default": []
    },
    "checklists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "default": []
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "default": []
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "claim",
        "scope",
        "confidence",
        "confidence_score",
        "source_count",
        "evidence_count",
        "updated_at",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["rule", "exception"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "task_types", "entities"],
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "task_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_count": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total": { "type": "number" },
            "clarity": { "type": "number" },
            "specificity": { "type": "number" },
            "evidence_strength": { "type": "number" },
            "freshness": { "type": "number" },
            "conflict_risk": { "type": "number" },
            "actionability": { "type": "number" }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": { "type": "string" },
            "reason": { "type": ["string", "null"] },
            "updated_at": { "type": "string", "format": "date-time" }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "authors": { "$ref": "#/$defs/idList" },
            "source_types": { "$ref": "#/$defs/idList" },
            "evidence_refs": { "$ref": "#/$defs/idList" }
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "supports": { "$ref": "#/$defs/idList" },
            "contradicts": { "$ref": "#/$defs/idList" },
            "supersedes": { "$ref": "#/$defs/idList" },
            "superseded_by": { "$ref": "#/$defs/idList" },
            "specializes": { "$ref": "#/$defs/idList" },
            "generalizes": { "$ref": "#/$defs/idList" },
            "related_to": { "$ref": "#/$defs/idList" }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visibility": { "type": "string" },
            "sensitivity": { "type": "string" },
            "redaction_status": { "type": "string" }
          }
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branches": { "$ref": "#/$defs/idList" },
            "valid_from_commit": { "type": ["string", "null"] },
            "valid_until_commit": { "type": ["string", "null"] },
            "tags": { "$ref": "#/$defs/idList" }
          }
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "idList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
