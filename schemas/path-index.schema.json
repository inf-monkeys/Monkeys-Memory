{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.infmonkeys.com/schemas/path-index.schema.json",
  "title": "PathIndex",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "org", "repo", "generated_at", "paths"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "org": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rules", "exceptions"],
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
