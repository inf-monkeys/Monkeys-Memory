#!/usr/bin/env bash

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "${SOURCE}" ]; do
  DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

COMMAND="${1:-}"
shift || true

case "${COMMAND}" in
  compile)
    exec node "${REPO_ROOT}/scripts/compile-memory.mjs" "$@"
    ;;
  retrieve)
    exec node "${REPO_ROOT}/scripts/retrieve-memory.mjs" "$@"
    ;;
  capture)
    exec node "${REPO_ROOT}/scripts/capture-experience.mjs" "$@"
    ;;
  sync)
    exec node "${REPO_ROOT}/scripts/sync-memory.mjs" "$@"
    ;;
  status)
    exec node "${REPO_ROOT}/scripts/status-memory.mjs" "$@"
    ;;
  review)
    exec node "${REPO_ROOT}/scripts/review-memory.mjs" "$@"
    ;;
  simulate)
    exec node "${REPO_ROOT}/scripts/simulate-memory.mjs" "$@"
    ;;
  benchmark)
    exec node "${REPO_ROOT}/scripts/benchmark-memory.mjs" "$@"
    ;;
  staleness)
    exec node "${REPO_ROOT}/scripts/staleness-memory.mjs" "$@"
    ;;
  validate-memory)
    exec node "${REPO_ROOT}/scripts/validate-memory.mjs" "$@"
    ;;
  redact)
    exec node "${REPO_ROOT}/scripts/redact-memory.mjs" "$@"
    ;;
  coverage)
    exec node "${REPO_ROOT}/scripts/coverage-memory.mjs" "$@"
    ;;
  impact)
    exec node "${REPO_ROOT}/scripts/impact-memory.mjs" "$@"
    ;;
  relations)
    exec node "${REPO_ROOT}/scripts/relations-memory.mjs" "$@"
    ;;
  feedback)
    exec node "${REPO_ROOT}/scripts/feedback-memory.mjs" "$@"
    ;;
  trajectory)
    exec node "${REPO_ROOT}/scripts/trajectory-memory.mjs" "$@"
    ;;
  hierarchy)
    exec node "${REPO_ROOT}/scripts/hierarchy-memory.mjs" "$@"
    ;;
  agent-action-result)
    exec node "${REPO_ROOT}/scripts/agent-action-result.mjs" "$@"
    ;;
  agent-capabilities)
    exec node "${REPO_ROOT}/scripts/agent-capabilities.mjs" "$@"
    ;;
  list)
    exec node "${REPO_ROOT}/scripts/list-experiences.mjs" "$@"
    ;;
  deprecate)
    exec node "${REPO_ROOT}/scripts/deprecate-experience.mjs" "$@"
    ;;
  init-repo)
    exec node "${REPO_ROOT}/scripts/init-repo.mjs" "$@"
    ;;
  *)
    cat <<EOF
Usage:
  monkeys-memory compile [--repo <repo>]
  monkeys-memory retrieve [--workspace <dir>] [--repo <repo>] [--path <path>] [--task <task>] [--format json|md]
  monkeys-memory capture --title <title> --claim <claim> [--workspace <dir>] [--repo <repo>] [--path <path>] [--task <task>] [--kind rule|exception] [--auto] [--dry-run]
  monkeys-memory sync [--no-pull] [--from-ref <ref>] [--to-ref <ref>]
  monkeys-memory status [--repo <repo>]
  monkeys-memory review [--repo <repo>] [--format table|json]
  monkeys-memory simulate [--workspace <dir>] [--repo <repo>] [--path <path>] [--task <task>]
  monkeys-memory benchmark [--out <file>]
  monkeys-memory staleness [--repo <repo>] [--workspace <repo-dir>] [--since <git-ref>]
  monkeys-memory validate-memory [--repo <repo>] [--workspace <repo-dir>]
  monkeys-memory redact [--repo <repo>] [--write]
  monkeys-memory coverage [--repo <repo>]
  monkeys-memory impact [--repo <repo>]
  monkeys-memory relations [--repo <repo>]
  monkeys-memory feedback --repo <repo> --id <memory-id> --outcome helpful|not-relevant|outdated|accepted|failed
  monkeys-memory trajectory --repo <repo> --file <events.json> [--write]
  monkeys-memory hierarchy
  monkeys-memory agent-action-result --action-id <id> [--workspace <dir>] [--no-report]
  monkeys-memory agent-capabilities
  monkeys-memory list --repo <repo> [--status active|deprecated] [--kind rule|exception] [--path <glob>] [--format json|table]
  monkeys-memory deprecate --repo <repo> --id <experience-id>
  monkeys-memory init-repo --workspace <path> [--no-hooks] [--no-claude]
EOF
    exit 1
    ;;
esac
