deployment:
  # local is the default mode for running the complete open-source product.
  # Use production when operating outside a private local environment.
  mode: local

server:
  port: 3000
  host: 0.0.0.0

database:
  host: localhost
  port: 5432
  user: postgres
  password: postgres
  name: monkeys_memory
  logging: false

redis:
  host: localhost
  port: 6379
  password:

embeddings:
  enabled: true
  # auto uses OpenAI-compatible embeddings when apiKey is set, otherwise falls
  # back to deterministic local-hash embeddings.
  provider: auto
  model: text-embedding-3-small
  dimensions: 1536
  apiKey:
  baseUrl: https://api.openai.com/v1
  timeoutMs: 10000
  # Applies when provider is openai-compatible but apiKey is missing. Request
  # failures fail closed so Qdrant collections never mix embedding models.
  fallbackToLocal: true

vectorStore:
  enabled: true
  provider: qdrant
  # Docker Compose overrides this to http://qdrant:6333. Set VECTOR_STORE_URL
  # for an external or managed Qdrant deployment.
  url: http://localhost:6333
  apiKey:
  collectionPrefix: monkeys_memory_items
  timeoutMs: 10000
  searchLimit: 80

console:
  baseUrl: http://localhost:8080

cors:
  allowedOrigins:
    - http://localhost:8080
    - http://127.0.0.1:8080
